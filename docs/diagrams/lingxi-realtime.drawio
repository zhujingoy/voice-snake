elBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mic" target="pcm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="编码与分帧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pcm" target="voice"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="API key 鉴权" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=1;exitY=0.3;entryX=0;entryY=0.3;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="auth" target="mint"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="申请 / 返回临时凭证" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=0.5;exitY=1;entryX=1;entryY=0.15;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="auth" target="voice"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="320" /><mxPoint x="550" y="320" /><mxPoint x="550" y="378" /></Array></mxGeometry></mxCell><mxCell id="e6" value="① 音频直传：Base64 PCM16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=1;exitY=0.45;entryX=0;entryY=0.45;" edge="1" parent="1" source="voice" target="rt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="② 用户转写 completed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=0;exitY=0.85;entryX=1;entryY=0.85;" edge="1" parent="1" source="rt" target="voice"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="469" /><mxPoint x="880" y="515" /><mxPoint x="550" y="515" /><mxPoint x="550" y="462" /></Array></mxGeometry></mxCell><mxCell id="e8" value="唯一最终结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="voice" target="parse"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#526575;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="parse" target="game"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="玩家点击开始即可，凭证自动申请，无需手动输入。音频与转写直达灵矽，项目后端不转发音频。&#10;凭证建议 120 秒用于建连；有效期不等于可玩时长。已建立连接不因凭证到期而主动重建。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=16;fillColor=#f5f5f5;strokeColor=#cccccc;spacing=12;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1230" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>